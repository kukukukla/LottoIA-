   "source": [
    "# 🎲 Motor Estatístico de Loterias v2.0\n",
    "## Notebook de Exemplo\n",
    "\n",
    "Este notebook demonstra o uso completo do sistema."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, 'core')\n",
    "\n",
    "from core import MotorPrincipal, Concurso, LoteriaTipo, EstrategiaConfig\n",
    "from datetime import date, timedelta\n",
    "import random\n",
    "import numpy as np\n",
    "\n",
    "random.seed(42)\n",
    "np.random.seed(42)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Carregar Dados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def gerar_dados(loteria, n=300):\n",
    "    concursos = []\n",
    "    base = date(2000, 1, 1)\n",
    "    for i in range(1, n + 1):\n",
    "        dezenas = sorted(random.sample(range(1, loteria.dezenas_totais + 1), loteria.dezenas_sorteadas))\n",
    "        concursos.append(Concurso(numero=i, data=base + timedelta(days=i*3), dezenas=dezenas, loteria=loteria))\n",
    "    return concursos\n",
    "\n",
    "concursos = gerar_dados(LoteriaTipo.LOTOFACIL, 300)\n",
    "motor = MotorPrincipal(concursos)\n",
    "print(f'Sistema inicializado: {motor.resumo()}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Análise Estatística"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "freq = motor.estatistico.frequencia_absoluta()\n",
    "top10 = sorted(freq.items(), key=lambda x: x[1], reverse=True)[:10]\n",
    "print('Top 10 dezenas mais frequentes:')\n",
    "for d, f in top10:\n",
    "    print(f'  Dezena {d}: {f} vezes')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Gerar Jogos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "jogos = motor.gerar_jogos('score', 15, 5)\n",
    "for i, j in enumerate(jogos, 1):\n",
    "    print(f'Jogo {i}: {j["dezenas"]}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Simulação Monte Carlo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "rel = motor.simulacoes.monte_carlo_aleatorio(1000, 15)\n",
    "print(f'Média de acertos: {rel.media_acertos}')\n",
    "print(f'Máximo: {rel.max_acertos}')\n",
    "print(f'Desvio padrão: {rel.desvio_padrao}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Testes Estatísticos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "chi = motor.comparativo.teste_chi_quadrado(concursos)\n",
    "print(f'Qui-Quadrado: p={chi["p_value"]}')\n",
    "print(f'Interpretação: {chi["conclusao"]}')"
   ]
  }
